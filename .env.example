# Production URL users return to after password reset (Firebase Auth email link)
REACT_APP_AUTH_CONTINUE_URL=https://fleettraq.vercel.app/login

# Legal pages — set your real operator name and contact email in production
REACT_APP_LEGAL_OPERATOR=Your Legal Name or Company
REACT_APP_LEGAL_CONTACT_EMAIL=you@example.com
REACT_APP_LEGAL_WEBSITE_URL=https://fleettraq.vercel.app

# Optional App Check (production)
# REACT_APP_ENABLE_APP_CHECK=true
# REACT_APP_RECAPTCHA_SITE_KEY=
