rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myOrg() {
      return myProfile().organizationId;
    }

    function memberStatusOk() {
      return hasProfile() &&
        !(('membershipStatus' in myProfile()) &&
          (myProfile().membershipStatus == 'pending' ||
           myProfile().membershipStatus == 'suspended'));
    }

    function isAdmin() {
      return hasProfile() && memberStatusOk() &&
        (myProfile().role == 'admin' || myProfile().role == 'manager');
    }

    function isDriverRole() {
      return hasProfile() && memberStatusOk() && myProfile().role == 'driver';
    }

    function activeFleet() {
      return memberStatusOk() && resource.data.accountId == myOrg();
    }

    function writeActiveFleet() {
      return memberStatusOk() && request.resource.data.accountId == myOrg();
    }

    function orgHasAdmin(orgId) {
      return exists(/databases/$(database)/documents/users/$(orgId)) &&
        get(/databases/$(database)/documents/users/$(orgId)).data.role == 'admin' &&
        (!('membershipStatus' in get(/databases/$(database)/documents/users/$(orgId)).data) ||
          get(/databases/$(database)/documents/users/$(orgId)).data.membershipStatus == 'active');
    }

    function vehicleAssignedToMe(vehicleId) {
      return vehicleId is string &&
        exists(/databases/$(database)/documents/vehicles/$(vehicleId)) &&
        get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.assignedDriverUid == request.auth.uid;
    }

    function validInviteForOrg(code, orgId) {
      return code is string &&
        code.size() >= 6 &&
        exists(/databases/$(database)/documents/invites/$(code)) &&
        get(/databases/$(database)/documents/invites/$(code)).data.active == true &&
        get(/databases/$(database)/documents/invites/$(code)).data.organizationId == orgId;
    }

    function photoWithinLimit() {
      return !('photoUrl' in request.resource.data) ||
        request.resource.data.photoUrl == null ||
        request.resource.data.photoUrl.size() < 1000000;
    }

    function driverDeviceMatchesVehicle(vehicleId, deviceId) {
      return vehicleId is string &&
        deviceId is string &&
        exists(/databases/$(database)/documents/vehicles/$(vehicleId)) &&
        (
          !('registeredDeviceId' in get(/databases/$(database)/documents/vehicles/$(vehicleId)).data) ||
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.registeredDeviceId == null ||
          get(/databases/$(database)/documents/vehicles/$(vehicleId)).data.registeredDeviceId == deviceId
        );
    }

    function driverCanRegisterDevice(vehicleId) {
      return isDriverRole() &&
        vehicleAssignedToMe(vehicleId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['registeredDeviceId', 'registeredDeviceAt', 'registeredByUid', 'updatedAt']) &&
        request.resource.data.accountId == resource.data.accountId &&
        request.resource.data.registeredByUid == request.auth.uid;
    }

    // ---- Fleet invite codes (document id = the code) ----
    match /invites/{code} {
      allow get: if signedIn() && resource.data.active == true;
      allow list: if isAdmin() && resource.data.organizationId == myOrg();
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.organizationId &&
        request.resource.data.active == true;
      allow update, delete: if isAdmin() && resource.data.organizationId == myOrg();
    }

    // ---- User profiles ----
    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId ||
          (hasProfile() && memberStatusOk() && resource.data.organizationId == myOrg()));

      allow create: if signedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'admin' &&
          request.resource.data.organizationId == userId &&
          request.resource.data.membershipStatus == 'active') ||
        (request.resource.data.role == 'driver' &&
          request.resource.data.membershipStatus == 'pending' &&
          request.resource.data.keys().hasAll(['inviteCodeUsed']) &&
          orgHasAdmin(request.resource.data.organizationId) &&
          validInviteForOrg(request.resource.data.inviteCodeUsed, request.resource.data.organizationId))
      );

      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.membershipStatus == resource.data.membershipStatus;

      allow update: if isAdmin() &&
        resource.data.organizationId == myOrg() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.role == resource.data.role &&
        (request.resource.data.membershipStatus == 'active' ||
         request.resource.data.membershipStatus == 'pending' ||
         request.resource.data.membershipStatus == 'suspended');

      allow delete: if signedIn() &&
        (request.auth.uid == userId ||
          (isAdmin() && resource.data.organizationId == myOrg()));
    }

    match /userSettings/{docId} {
      allow read, write: if signedIn() && docId == request.auth.uid + '_user';
    }

    match /vehicles/{docId} {
      allow read: if activeFleet();
      allow create: if writeActiveFleet() && isAdmin();
      allow update: if activeFleet() && (
        (isAdmin() && writeActiveFleet()) ||
        driverCanRegisterDevice(docId)
      );
      allow delete: if activeFleet() && isAdmin();
    }

    match /drivers/{docId} {
      allow read: if activeFleet();
      allow create: if writeActiveFleet() && isAdmin() && photoWithinLimit();
      allow update: if activeFleet() && isAdmin() && writeActiveFleet() && photoWithinLimit();
      allow delete: if activeFleet() && isAdmin();
    }

    match /tracking/{docId} {
      allow read: if activeFleet();
      allow create: if writeActiveFleet() && (
        isAdmin() ||
        (isDriverRole() &&
          vehicleAssignedToMe(request.resource.data.vehicleId) &&
          driverDeviceMatchesVehicle(request.resource.data.vehicleId, request.resource.data.deviceId))
      );
      allow update: if activeFleet() && resource.data.accountId == myOrg() && (
        isAdmin() ||
        (isDriverRole() &&
          vehicleAssignedToMe(resource.data.vehicleId) &&
          request.resource.data.vehicleId == resource.data.vehicleId &&
          request.resource.data.accountId == resource.data.accountId &&
          request.resource.data.deviceId == resource.data.deviceId &&
          driverDeviceMatchesVehicle(resource.data.vehicleId, resource.data.deviceId))
      );
      allow delete: if activeFleet() && isAdmin();
    }

    match /routePoints/{docId} {
      allow read: if activeFleet();
      allow create: if writeActiveFleet() &&
        request.resource.data.accountId == myOrg() &&
        request.resource.data.vehicleId is string &&
        request.resource.data.deviceId is string &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number &&
        request.resource.data.timestamp is string && (
          isAdmin() ||
          (isDriverRole() &&
            vehicleAssignedToMe(request.resource.data.vehicleId) &&
            driverDeviceMatchesVehicle(request.resource.data.vehicleId, request.resource.data.deviceId))
        );
      allow update: if false;
      allow delete: if activeFleet() && isAdmin();
    }

    match /geofences/{docId} {
      allow read: if activeFleet();
      allow create: if writeActiveFleet() && isAdmin();
      allow update: if activeFleet() && isAdmin() && writeActiveFleet();
      allow delete: if activeFleet() && isAdmin();
    }

    match /fleetSettings/{docId} {
      allow read: if signedIn() && (
        docId == request.auth.uid + '_fleet' ||
        (hasProfile() && docId == myOrg() + '_fleet')
      );
      allow create, update: if signedIn() && docId == request.auth.uid + '_fleet' && isAdmin();
      allow delete: if signedIn() && docId == request.auth.uid + '_fleet' && isAdmin();
    }

    match /reports/{docId} {
      allow read: if activeFleet();
      allow create, update, delete: if writeActiveFleet() && isAdmin();
    }

    match /fuelRecords/{docId} {
      allow read: if activeFleet();
      allow create: if writeActiveFleet() && (
        isAdmin() ||
        (isDriverRole() &&
          vehicleAssignedToMe(request.resource.data.vehicleId) &&
          request.resource.data.recordedByUid == request.auth.uid)
      );
      allow update: if activeFleet() && writeActiveFleet() && (
        isAdmin() ||
        (isDriverRole() &&
          resource.data.recordedByUid == request.auth.uid &&
          vehicleAssignedToMe(resource.data.vehicleId) &&
          request.resource.data.vehicleId == resource.data.vehicleId &&
          request.resource.data.recordedByUid == request.auth.uid)
      );
      allow delete: if activeFleet() && (
        isAdmin() ||
        (isDriverRole() &&
          resource.data.recordedByUid == request.auth.uid &&
          vehicleAssignedToMe(resource.data.vehicleId))
      );
    }

    match /sessions/{docId} {
      allow read, create, update, delete: if activeFleet() && isAdmin();
    }

    match /deletionRequests/{docId} {
      allow read, create, update, delete: if activeFleet() && isAdmin();
    }

    match /notifications/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.read == false && (
        request.resource.data.userId == request.auth.uid ||
        (hasProfile() && isDriverRole() && request.resource.data.userId == myOrg())
      );
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
